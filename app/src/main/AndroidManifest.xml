<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v2.2 대중 공개용: 앱 코드가 직접 인터넷을 쓰지 않아 INTERNET 권한을 뺄댔다
         (음성인식은 구글 음성인식 서비스 앱이 대신 통신한다). -->

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- Android 11+ 패키지 가시성: 구글 음성인식기(ComponentName 지정)와 TTS 엔진을 찾기 위해 필요.
         v2.10 부터 한국어는 구글 TTS(com.google.android.tts), 영어는 삼성 TTS(com.samsung.SMT)를
         먼저 열기 때문에 두 패키지를 모두 보이게 해 둔다. -->
    <queries>
        <!-- 실기기에서 검증된 구글 인식기·한국어 TTS(com.google.android.tts)를 직접 지정하기 위해 필요 -->
        <package android:name="com.google.android.tts" />
        <!-- 영어 TTS 의 첫 후보(삼성 TTS) -->
        <package android:name="com.samsung.SMT" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceWordGame">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 숨은 관리자 화면(구구단 잠금을 통과해야만 열린다) -->
        <activity
            android:name=".admin.AdminActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
