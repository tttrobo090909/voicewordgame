<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.VoiceWordGame" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/coral_deep</item>
        <item name="colorPrimaryDark">@color/cream_deep</item>
        <item name="colorAccent">@color/coral_deep</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream_deep</item>
        <item name="android:navigationBarColor">@color/cream_deep</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Cute.Dialog</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <style name="ThemeOverlay.Cute.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/coral_deep</item>
        <item name="colorSecondary">@color/mint_deep</item>
        <item name="android:background">@color/cream</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextSection">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.CuteButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_soft</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.CutePrimary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
