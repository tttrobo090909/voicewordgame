<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/TextTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_title"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/adminCount"
                style="@style/TextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/closeAdmin"
                style="@style/Widget.CuteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:text="@string/back"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- v2.3: 한 판 문제 수·문제 제한시간 설정(검색·새 문제 위쪽) -->
        <LinearLayout
            android:id="@+id/adminSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_settings_title"
                android:textSize="14sp" />

            <!-- 한 판 문제 수: 10~50, 기본 15 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_setting_questions"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settingCountMinus"
                    style="@style/Widget.CuteButton"
                    android:layout_width="40dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/admin_setting_minus_desc"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/admin_setting_minus"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/settingCountValue"
                    style="@style/TextBody"
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/admin_setting_questions_value"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settingCountPlus"
                    style="@style/Widget.CuteButton"
                    android:layout_width="40dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/admin_setting_plus_desc"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/admin_setting_plus"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 문제 제한시간: 3~20초, 기본 9초 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_setting_time"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settingTimeMinus"
                    style="@style/Widget.CuteButton"
                    android:layout_width="40dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/admin_setting_minus_desc"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/admin_setting_minus"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/settingTimeValue"
                    style="@style/TextBody"
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/admin_setting_time_value"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settingTimePlus"
                    style="@style/Widget.CuteButton"
                    android:layout_width="40dp"
                    android:layout_height="38dp"
                    android:contentDescription="@string/admin_setting_plus_desc"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/admin_setting_plus"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- v2.6: 카테고리 관리(기본 6개 + 최대 4개 추가, 이름·영문·대표 이모지 수정, 추가분 삭제) -->
        <LinearLayout
            android:id="@+id/adminCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_categories_title"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/addCategory"
                    style="@style/Widget.CuteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="34dp"
                    android:minWidth="0dp"
                    android:text="@string/admin_category_add"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/adminCategoryHint"
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/admin_category_hint"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/adminCategoryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/adminSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:hint="@string/admin_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/addProblem"
                style="@style/Widget.CuteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/admin_add"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/adminFilterRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/adminEmpty"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/admin_empty"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/problemList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:scrollbars="none" />

        <!-- v2.6: 기본값 복원을 둘로 나눈다 — 설정만(문제 수·제한시간) / 문제 목록·카테고리 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/resetSettings"
                style="@style/Widget.CuteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/admin_reset_settings"
                android:textSize="13sp" />

            <Button
                android:id="@+id/resetProblems"
                style="@style/Widget.CuteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/admin_reset_problems"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
