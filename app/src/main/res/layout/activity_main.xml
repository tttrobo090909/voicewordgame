<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 상단 바: 왼쪽 제목(빠르게 3번 탭 = 관리자 잠금), 오른쪽 한글|ENG -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/titleText"
                style="@style/TextTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@null"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:soundEffectsEnabled="false"
                android:stateListAnimator="@null"
                android:text="@string/app_title"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/score_zero"
                android:textColor="@color/coral_deep"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/langToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_toggle_container"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/langKo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_toggle_on"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/lang_ko"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/langEn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_toggle_off"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/lang_en"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 첫 화면 ==================== -->
        <LinearLayout
            android:id="@+id/setupScreen"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ScrollView
                android:id="@+id/setupScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <!-- 슬림 배너: 작은 병아리 + 한 줄 안내 -->
                    <LinearLayout
                        android:id="@+id/slimBanner"
                        android:layout_width="match_parent"
                        android:layout_height="116dp"
                        android:background="@drawable/bg_banner_slim"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:id="@+id/chickImage"
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitCenter"
                            android:src="@drawable/chick_mascot" />

                        <TextView
                            android:id="@+id/bannerText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/banner_line"
                            android:textColor="@color/ink"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        style="@style/TextSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/choose_problems" />

                    <!-- 6개 카테고리를 먼저 두고, 전체 무작위는 맨 아래에 둔다. -->
                    <LinearLayout
                        android:id="@+id/categoryGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/randomButton"
                        style="@style/Widget.CuteChoice"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/category_all"
                        android:textSize="18sp" />

                    <!-- 게임 시작은 화면 맨 아래가 아니라 전체 무작위 바로 아래에 둔다(v2.2). -->
                    <Button
                        android:id="@+id/startButton"
                        style="@style/Widget.CutePrimary"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/start_game" />

                    <TextView
                        android:id="@+id/versionText"
                        style="@style/TextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text=""
                        android:textSize="11sp" />

                    <TextView
                        style="@style/TextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/footer_note"
                        android:textSize="10sp" />

                    <!-- v2.3: 개인정보처리방침(작은 글씨) — 구구단 부모 확인 잠금 뒤에 열린다 -->
                    <TextView
                        android:id="@+id/privacyLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="4dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="4dp"
                        android:text="@string/privacy_link"
                        android:textColor="@color/coral_deep"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- ==================== 게임 화면 ==================== -->
        <LinearLayout
            android:id="@+id/gameScreen"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <!-- v2.3: 병아리 타이머 바 하나에 상태 안내 문구·배경색을 합쳤다(54dp).
                 v2.4: 병아리를 v2.2만큼 크게 되돌리고, 문구는 바 한가운데 배경처럼 둔다. -->
            <FrameLayout
                android:id="@+id/timerBanner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_banner_info"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <!-- v2.4: 상태 안내 문구는 바 정중앙에 배경처럼 깔린다(병아리가 글자 앞을 지나간다). -->
                <TextView
                    android:id="@+id/gameStatus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/game_hint_line"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- v2.4: 병아리는 v2.2만큼 크게(44dp) 바 높이를 채우고, 문구보다 앞 레이어에서
                     왼쪽 끝에서 오른쪽 끝으로 걸어간다. (자식 순서상 문구 다음 = 위에 그려짐) -->
                <ImageView
                    android:id="@+id/timerChick"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical|start"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/chick_mascot" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_image_card"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/wordImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_title"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <!-- 그림 위 큰 힌트 배지 -->
                <TextView
                    android:id="@+id/hintBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_hint_badge"
                    android:elevation="6dp"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/ink"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/answerReveal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:gravity="center"
                android:minHeight="34dp"
                android:text="@string/what_is_it"
                android:textColor="@color/ink_soft"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/hintButton"
                    style="@style/Widget.CuteButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/hint_button" />

                <Button
                    android:id="@+id/skipButton"
                    style="@style/Widget.CuteButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/skip_button" />

                <Button
                    android:id="@+id/answerButton"
                    style="@style/Widget.CuteButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/answer_button"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/stopButton"
                    style="@style/Widget.CuteButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/stop_game"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/micStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:textColor="@color/ink_soft"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <com.pipi.voicewordgame.ui.ParticleView
        android:id="@+id/particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
