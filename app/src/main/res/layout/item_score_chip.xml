<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_score_chip"
    android:gravity="center_vertical"
    android:minWidth="86dp"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingTop="5dp"
    android:paddingEnd="11dp"
    android:paddingBottom="5dp">

    <ImageView
        android:id="@+id/chipAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/setup_players_title"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chipName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="90dp"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/coral_deep"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
