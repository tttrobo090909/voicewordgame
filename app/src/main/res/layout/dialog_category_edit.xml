<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="4dp">

        <TextView
            style="@style/TextSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_ko" />

        <EditText
            android:id="@+id/categoryKo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:hint="@string/category_ko_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            style="@style/TextSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/category_en" />

        <EditText
            android:id="@+id/categoryEn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:hint="@string/category_en_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            style="@style/TextSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/category_emoji" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/categoryEmoji"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:hint="@string/category_emoji_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="8"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/categoryEmojiRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/categoryError"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/category_need_name"
            android:textColor="@color/bad"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
